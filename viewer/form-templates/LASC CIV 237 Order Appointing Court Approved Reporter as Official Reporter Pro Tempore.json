9.7,43.5,11.04,1,0],["Telephone:",326.39,369.7,55.01,11.04,1,0],["Email:",350.86,388.19,30.54,11.04,1,0],["2.",44.87,427.19,9.19,11.04,0,0],["Court Reporter Agreement",62.84,427.19,138.83,11.04,0,0],["By signing this agreement, and accepting this appointment as an official Court Reporter Pro Tempore in",62.39,441.59,508.18,11.04,1,0],["this matter, the reporter confirms and agrees: (1) to maintain a valid, current California Certified Shorthand",62.39,454.18,508.2,11.04,1,0],["Reporter License and maintain current contact information with the Court as directed by the Court’s",62.39,466.78,508.22,11.04,1,0],["Director of Courtroom Support; (2) that appearance fees, including real time fees, are the responsibility of",62.39,479.5,508.27,11.04,1,0],["the party or parties who arranged the reporter services, and may not be charged to the Court; (3) to comply",62.39,492.09,508.03,11.04,1,0],["with statutes and rules applicable to official Court Reporter Pro Tempore, including the duty to timely",62.39,504.81,508.14,11.04,1,0],["prepare transcripts in the proper appellate form; (4) to receive and respond to notifications from the Civil",62.39,517.41,508.07,11.04,1,0],["Appeals Unit through the email address above; (5) to upload/publish requested copy/copies of appellate",62.39,530,508.02,11.04,1,0],["transcripts to the Civil Appeals Unit if requested; (6) to archive reporting notes of court proceedings in the",62.39,542.72,508.16,11.04,1,0],["Archival",62.39,555.33,39.16,11.04,1,0],["Court",108.46,555.33,26.94,11.04,1,0],["Reporter",142.29,555.33,42.78,11.04,1,0],["Notes",191.96,555.33,28.79,11.04,1,0],["(ACORN)",227.59,555.33,47.12,11.04,1,0],["electronic",281.59,555.33,47.02,11.04,1,0],["storage",335.58,555.33,36.73,11.04,1,0],["system",379.12,555.33,34.87,11.04,1,0],["as",420.88,555.33,11.52,11.04,1,0],["the",439.36,555.33,15.37,11.04,1,0],["designated",461.55,555.33,53.88,11.04,1,0],["repository",522.25,555.33,48.35,11.04,1,0],["established by the Court; (7) to follow directions from the Court, and to be subject to the jurisdiction of the",62.39,568.05,508.19,11.04,1,0],["Court to the same extent as an official reporter; (8) to be available to read the notes back to the jury if",62.39,580.65,508.24,11.04,1,0],["serving during a jury trial.",62.39,593.36,122.92,11.04,1,0],["Date:",63.23,624.56,27.54,11.04,0,0],["Signature:",248.39,624.56,54.45,11.04,0,0]],"fields":[[39.96,47.8,292.83,96.5,0,2],[292.8,48.36,404.27,64.07,0,2],[127.93,96.44,404.28,110.04,0,2],[40.79,147.24,404.28,161.64,0,2],[40.81,171.73,404.3,186.13,0,2],[40.79,196.27,404.28,210.67,0,2],[405,226.14,571.08,247.91,0,2],[112.56,286.68,310.58,301.08,0,2],[108.87,305.52,312.43,339.38,0,2],[387,286.68,571.21,301.08,0,2],[387,305.52,571.21,319.92,0,2],[387,324,571.21,364.91,0,2],[112.56,350.28,310.59,364.68,0,2],[108.87,368.76,312.43,402.55,0,2],[387,368.76,571.21,383.16,0,2],[386.28,387.24,571.21,401.64,0,2],[95.38,623.66,243,638.06,0,2]],"boxes":[]},{"n":2,"form":"SCLAC CIV 237","keys":["iascciv237"],"rev":"0426","w":612,"h":792,"items":[["ORDER",181.56,736.2,35.27,9.96,0,0],["APPOINTING",219.24,736.2,60.31,9.96,0,0],["COURT APPROVED REPORTER",282,736.2,148.44,9.96,0,0],["AS OFFICIAL",207.96,745.44,62.61,9.96,0,0],["REPORTER",273.48,745.44,54.83,9.96,0,0],["PRO TEMPORE",330.96,745.44,72.9,9.96,0,0],["Cal. Rules of Court, rule",479.88,736.2,96.08,9,1,0],["2.956 Gov. Code §§",495.36,745.44,80.61,9,1,0],["68086, 70044",520.92,754.68,55.16,9,1,0],["SCLAC",36.22,737.46,30.01,9,1,0],["CIV 237 Rev. 04/2",68.73,737.46,73.29,9,1,0],["6",142.04,737.46,5,9,1,0],["For Mandatory Use",36.22,745.62,77.55,9,1,0],["CASE NAME:",41.64,48.6,49.4,8.04,1,0],["CASE NUMBER:",384.24,48.6,61.03,8.04,1,0],["Order Appointing Court Reporter Pro Tempore",58.68,125.88,243.3,11.04,0,0],["Pursuant to Government Code sections 68086, 70044 and California Rules of Court, rule 2.956, the above-",58.21,139.32,509.47,11.04,1,0],["identified Certified Shorthand Reporter is appointed as an official Court Reporter Pro Tempore in these",58.21,152.03,509.18,11.04,1,0],["proceedings and is ordered to comply with the terms of the Court Reporter Agreement set forth above.",58.21,164.63,509.11,11.04,1,0],["Any party who orders proceedings transcribed by the official Court Reporter Pro Tempore may be ordered",58.21,177.35,509.27,11.04,1,0],["to lodge a copy of the transcript with the Court.",58.21,189.95,227.56,11.04,1,0],["Date:",58.8,263.27,27.55,11.04,0,0],["Good Cause Appearing, IT IS SO ORDERED:",314.29,240.83,232.3,11.04,0,0],["Judicial Officer",402.84,276.95,72.18,11.04,1,0]],"fields":[[36.47,62.49,378.6,84.26,0,2],[379.04,62.51,576.88,84.28,0,2],[91.8,262.32,260.64,276.72,0,2],[288.1,262.54,572.95,276.94,0,2]],"boxes":[]}]}