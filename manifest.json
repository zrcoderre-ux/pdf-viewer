{
  "manifest_version": 3,
  "name": "PDF Viewer",
  "version": "2.0.0",
  "description": "Edit, sign, comment, redact, protect and export PDFs in Chrome, with clickable Westlaw / Lexis+ links for legal citations.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webNavigation",
    "tabs",
    "tabGroups",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "viewer/shift-space-open.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "citation-site-rules.js",
        "content/claude-citations.js"
      ],
      "css": [
        "content/claude-citations.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PDF Viewer",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "viewer/viewer.html",
        "viewer/viewer.js",
        "viewer/viewer.css",
        "viewer/citation-linker.js",
        "viewer/citation-memory.js",
        "viewer/toa.js",
        "viewer/footer-naming.js",
        "viewer/disambiguation.js",
        "viewer/naming-override.js",
        "viewer/highlights.js",
        "viewer/reporters.js",
        "viewer/statute-codes.js",
        "viewer/federal-codes.js",
        "viewer/code-tables.js",
        "viewer/ocr.js",
        "viewer/pdf-fonts.js",
        "viewer/ocr-store.js",
        "viewer/rotation.js",
        "viewer/web-shim.js",
        "viewer/theme-boot.js",
        "viewer/text-reader.html",
        "viewer/text-reader.js",
        "viewer/text-reader.css",
        "viewer/reader-options.js",
        "viewer/textdoc.js",
        "viewer/rules.js",
        "viewer/pdfsync.js",
        "viewer/pseudo-key.js",
        "viewer/key-library.js",
        "viewer/redact.js",
        "viewer/pdf-edit.js",
        "viewer/xlsx-read.js",
        "viewer/xlsx-write.js",
        "viewer/leaks.js",
        "viewer/autoscroll.js",
        "viewer/icons.js",
        "viewer/ui.js",
        "viewer/annotations.js",
        "viewer/annot-pdf.js",
        "viewer/features.js",
        "viewer/find.js",
        "viewer/print.js",
        "viewer/signature.js",
        "viewer/pdf-crypt.js",
        "viewer/textlayout.js",
        "viewer/zip.js",
        "viewer/vendor/pdf-lib/pdf-lib.esm.min.js",
        "viewer/vendor/tesseract/tesseract.esm.min.js",
        "viewer/vendor/tesseract/worker.min.js",
        "viewer/vendor/tesseract/tesseract-core-lstm.wasm.js",
        "viewer/vendor/tesseract/tesseract-core-lstm.wasm",
        "viewer/vendor/tesseract/eng.traineddata",
        "pdfjs/build/pdf.mjs",
        "pdfjs/build/pdf.worker.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
