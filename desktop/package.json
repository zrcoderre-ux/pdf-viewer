{
  "name": "pdfplus",
  "productName": "PDF+",
  "version": "0.2.0",
  "description": "PDF+, the desktop app: the PDF Viewer's editor and citation links, installed on the computer, with no network.",
  "private": true,
  "main": "main.js",
  "author": "zrcoderre",
  "license": "UNLICENSED",
  "repository": "github:zrcoderre-ux/pdf-viewer",
  "scripts": {
    "assemble": "node assemble.mjs",
    "start": "node assemble.mjs && electron .",
    "dist": "node assemble.mjs && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.zrcoderre.pdfplus",
    "productName": "PDF+",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "shim.js",
      "package.json",
      "build/icon.png",
      "app/**/*"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/zrcoderre-ux/pdf-viewer/releases/latest/download"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "executableName": "PDF+"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PDFPlus-Setup-${version}.${ext}",
      "shortcutName": "PDF+",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
